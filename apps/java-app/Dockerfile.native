FROM ghcr.io/graalvm/native-image-community:25 AS builder
WORKDIR /app
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./
COPY src src
RUN ./gradlew nativeCompile -x test

FROM debian:bookworm-slim
WORKDIR /app
COPY --from=builder /app/build/native/nativeCompile/java-app ./app
EXPOSE 8080
ENTRYPOINT ["./app"]